[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_vtx_5 : source_color;
uniform sampler2D tex_frg_2 : source_color;
uniform sampler2D tex_frg_3 : source_color;
uniform sampler2D depth_tex_frg_21 : hint_depth_texture;
uniform sampler2D tex_frg_14 : source_color;
uniform vec4 bright_color : source_color = vec4(1.000000, 0.300000, 0.100000, 1.000000);
uniform sampler2D tex_frg_11 : source_color;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:3
	vec3 n_out3p0 = NORMAL;


// Input:9
	float n_out9p0 = TIME;


// VectorOp:10
	vec2 n_in10p1 = vec2(0.00000, 1.00000);
	vec2 n_out10p0 = vec2(n_out9p0) * n_in10p1;


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out10p0 * n_in8p1 + UV;


// Texture2D:5
	vec4 n_out5p0 = texture(tex_vtx_5, n_out8p0);
	float n_out5p1 = n_out5p0.r;


// FloatOp:7
	float n_in7p1 = 0.20000;
	float n_out7p0 = n_out5p1 * n_in7p1;


// VectorOp:6
	vec3 n_out6p0 = n_out3p0 * vec3(n_out7p0);


// VectorOp:4
	vec3 n_out4p0 = n_out2p0 + n_out6p0;


// Output:0
	VERTEX = n_out4p0;


}

void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);
	float n_out2p1 = n_out2p0.r;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, vec2(n_out2p1));


	float n_out21p0;
// ProximityFade:21
	float n_in21p0 = 1.00000;
	{
		float __depth_tex = texture(depth_tex_frg_21, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out21p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_in21p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// Input:19
	vec4 n_out19p0 = COLOR;
	float n_out19p4 = n_out19p0.a;


// Texture2D:14
	vec4 n_out14p0 = texture(tex_frg_14, UV);
	float n_out14p1 = n_out14p0.r;


// SmoothStep:15
	vec3 n_in15p1 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out15p0 = smoothstep(vec3(n_out19p4), n_in15p1, vec3(n_out14p1));


// VectorOp:20
	vec3 n_out20p0 = vec3(n_out21p0) * n_out15p0;


// ColorParameter:4
	vec4 n_out4p0 = bright_color;


// FloatConstant:5
	float n_out5p0 = 20.000000;


// VectorOp:6
	vec2 n_out6p0 = vec2(n_out4p0.xy) * vec2(n_out5p0);


// Input:18
	vec4 n_out18p0 = COLOR;
	float n_out18p1 = n_out18p0.r;


// Texture2D:11
	vec4 n_out11p0 = texture(tex_frg_11, UV);


// SmoothStep:9
	vec3 n_in9p1 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out9p0 = smoothstep(vec3(n_out18p1), n_in9p1, vec3(n_out11p0.xyz));


// VectorOp:8
	vec3 n_out8p0 = vec3(n_out6p0, 0.0) * n_out9p0;


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out20p0.x;
	EMISSION = n_out8p0;


}
